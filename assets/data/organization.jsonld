  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios de ingeniería y construcción",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Asesorías técnicas",
          "description": "Apoyo especializado a mandantes y unidades técnicas en la toma de decisiones de ingeniería durante el ciclo del proyecto."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Revisión de proyectos",
          "description": "Revisión independiente de proyectos de arquitectura y especialidades: consistencia, memorias, planos y cumplimiento normativo."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Estudios de impacto vial",
          "description": "Evaluación de flujos, accesos y mitigaciones viales para permisos y proyectos que generan nueva demanda de transporte."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Memorias de cálculo estructural",
          "description": "Diseño y cálculo de estructuras de hormigón armado, acero y albañilería, con memoria y planos para permisos y construcción."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Accesos a predios",
          "description": "Diseño y construcción de accesos vehiculares a predios agrícolas, industriales y habitacionales, con carpeta técnica para la autoridad vial."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Construcción y obras civiles",
          "description": "Ejecución de obras civiles: fundaciones, pavimentos, obras de drenaje, muros y mejoramientos, con control de calidad y avance."
        }
      }
    ]
  }
